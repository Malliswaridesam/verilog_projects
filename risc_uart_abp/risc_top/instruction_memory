module im(
    input clk, rst,
    input [31:0] pc,
    output [31:0] ins_out
);

reg [7:0] mem[120:0];

assign ins_out = {mem[pc+3], mem[pc+2], mem[pc+1], mem[pc]};

always @(posedge clk) begin
    if (rst == 1'b1) begin
        // Store Word (SW) Instructions - Example with different registers and offsets
        mem[3]  = 8'h00; // SW x5, 0(x1)
        mem[2]  = 8'hA1;
        mem[1]  = 8'h20;
        mem[0]  = 8'h23;

        mem[7]  = 8'h04; // SW x6, 4(x2)
        mem[6]  = 8'hB2;
        mem[5]  = 8'h24;
        mem[4]  = 8'h23;

        mem[11] = 8'h08; // SW x7, 8(x3)
        mem[10] = 8'hC3;
        mem[9]  = 8'h28;
        mem[8]  = 8'h23;

        mem[15] = 8'h0C; // SW x8, 12(x4)
        mem[14] = 8'hD4;
        mem[13] = 8'h2C;
        mem[12] = 8'h23;

        mem[19] = 8'h10; // SW x9, 16(x5)
        mem[18] = 8'hE5;
        mem[17] = 8'h30;
        mem[16] = 8'h23;

        mem[23] = 8'h14; // SW x10, 20(x6)
        mem[22] = 8'hF6;
        mem[21] = 8'h34;
        mem[20] = 8'h23;

        mem[27] = 8'h18; // SW x11, 24(x7)
        mem[26] = 8'h07;
        mem[25] = 8'h38;
        mem[24] = 8'h23;

        mem[31] = 8'h1C; // SW x12, 28(x8)
        mem[30] = 8'h18;
        mem[29] = 8'h3C;
        mem[28] = 8'h23;

        mem[35] = 8'h20; // SW x13, 32(x9)
        mem[34] = 8'h29;
        mem[33] = 8'h40;
        mem[32] = 8'h23;

        mem[39] = 8'h24; // SW x14, 36(x10)
        mem[38] = 8'h3A;
        mem[37] = 8'h44;
        mem[36] = 8'h23;

        mem[43] = 8'h28; // SW x15, 40(x11)
        mem[42] = 8'h4B;
        mem[41] = 8'h48;
        mem[40] = 8'h23;

        mem[47] = 8'h2C; // SW x16, 44(x12)
        mem[46] = 8'h5C;
        mem[45] = 8'h4C;
        mem[44] = 8'h23;

        mem[51] = 8'h30; // SW x17, 48(x13)
        mem[50] = 8'h6D;
        mem[49] = 8'h50;
        mem[48] = 8'h23;

        mem[55] = 8'h34; // SW x18, 52(x14)
        mem[54] = 8'h7E;
        mem[53] = 8'h54;
        mem[52] = 8'h23;

        mem[59] = 8'h38; // SW x19, 56(x15)
        mem[58] = 8'h8F;
        mem[57] = 8'h58;
        mem[56] = 8'h23;

        mem[63] = 8'h3C; // SW x20, 60(x16)
        mem[62] = 8'hA0;
        mem[61] = 8'h5C;
        mem[60] = 8'h23;

        // Optional: Pad remaining memory with NOPs (0x00000013)
        mem[67] = 8'h00; // NOP
        mem[66] = 8'h00;
        mem[65] = 8'h00;
        mem[64] = 8'h13;

        mem[71] = 8'h00; // NOP
        mem[70] = 8'h00;
        mem[69] = 8'h00;
        mem[68] = 8'h13;

        mem[75] = 8'h00; // NOP
        mem[74] = 8'h00;
        mem[73] = 8'h00;
        mem[72] = 8'h13;
    end
end

endmodule
